{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://exposure-atlas.invalid/schemas/domain/classification-proposal.schema.json",
 "title": "ClassificationProposal",
 "type": "object",
 "required": [
  "schema_version",
  "proposal_id",
  "target_ref",
  "labels",
  "taxonomy_version",
  "rubric_version",
  "proposed_by",
  "run_id"
 ],
 "properties": {
  "schema_version": {
   "const": "atlas-classification-proposal/v1"
  },
  "proposal_id": {
   "type": "string",
   "pattern": "^cpr_[a-z0-9]{8,}$"
  },
  "target_ref": {
   "type": "object"
  },
  "labels": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "other_detail": {
   "type": "string"
  },
  "taxonomy_version": {
   "type": "string",
   "minLength": 1
  },
  "rubric_version": {
   "type": "string",
   "minLength": 1
  },
  "proposed_by": {
   "enum": [
    "manual",
    "model"
   ]
  },
  "run_id": {
   "type": "string",
   "minLength": 1
  },
  "rationale": {
   "type": "string"
  }
 },
 "unevaluatedProperties": false
}
