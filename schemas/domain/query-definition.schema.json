{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://exposure-atlas.invalid/schemas/domain/query-definition.schema.json",
 "title": "QueryDefinition (versioned; DISC-002)",
 "type": "object",
 "required": [
  "schema_version",
  "query_id",
  "version",
  "source_id",
  "jurisdiction",
  "query",
  "effective_from"
 ],
 "properties": {
  "schema_version": {
   "const": "atlas-query-definition/v1"
  },
  "query_id": {
   "type": "string",
   "pattern": "^q_[a-z0-9_]+$"
  },
  "version": {
   "type": "string",
   "minLength": 1
  },
  "source_id": {
   "type": "string",
   "minLength": 1
  },
  "jurisdiction": {
   "type": "string",
   "minLength": 1
  },
  "category": {
   "type": [
    "string",
    "null"
   ]
  },
  "language": {
   "type": "string",
   "default": "en"
  },
  "query": {
   "type": "string",
   "minLength": 1
  },
  "effective_from": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "effective_to": {
   "anyOf": [
    {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    {
     "type": "null"
    }
   ]
  },
  "expected_min_results": {
   "type": "integer",
   "minimum": 0
  },
  "supersedes": {
   "type": [
    "string",
    "null"
   ]
  }
 },
 "unevaluatedProperties": false
}
