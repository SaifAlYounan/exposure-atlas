{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://exposure-atlas.invalid/schemas/domain/boundary-proposal.schema.json",
 "title": "BoundaryProposal",
 "type": "object",
 "required": [
  "schema_version",
  "proposal_id",
  "candidate_id",
  "boundary_version",
  "criteria",
  "proposed_outcome",
  "proposed_by"
 ],
 "properties": {
  "schema_version": {
   "const": "atlas-boundary-proposal/v1"
  },
  "proposal_id": {
   "type": "string",
   "pattern": "^bpr_[a-z0-9]{8,}$"
  },
  "candidate_id": {
   "type": "string",
   "pattern": "^cnd_[a-z0-9]{8,}$"
  },
  "boundary_version": {
   "type": "string",
   "minLength": 1
  },
  "criteria": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "unevaluatedProperties": false,
    "required": [
     "criterion",
     "result"
    ],
    "properties": {
     "criterion": {
      "type": "string",
      "minLength": 1
     },
     "result": {
      "enum": [
       "met",
       "not_met",
       "uncertain",
       "not_applicable"
      ]
     },
     "anchor_ids": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "proposed_outcome": {
   "enum": [
    "include",
    "exclude",
    "uncertain"
   ]
  },
  "proposed_by": {
   "enum": [
    "manual",
    "model"
   ]
  }
 },
 "unevaluatedProperties": false
}
