{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exposure-atlas.invalid/schemas/plan/task-evidence-receipt.schema.json",
  "title": "Task evidence receipt (index entry; raw tool events never appear here)",
  "type": "object",
  "unevaluatedProperties": false,
  "required": ["schema_version", "receipt_id", "task_id", "builder_profile", "base_commit", "result_commit", "commands", "criteria", "self_asserted", "recorded_at"],
  "properties": {
    "schema_version": { "const": "atlas-task-evidence-receipt/v1" },
    "receipt_id": { "type": "string", "pattern": "^rcpt_[a-z0-9-]{4,}$" },
    "task_id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}[A-Z]?(-[0-9]{2})?$" },
    "run_id": { "type": "string" },
    "session_id": { "type": "string" },
    "builder_profile": { "const": "claude" },
    "sdk_version": { "type": "string" },
    "builder_model": { "type": "string" },
    "base_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "result_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "config_hashes": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "input_hashes": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "artifact_hashes": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "unevaluatedProperties": false,
        "required": ["cmd", "exit_code"],
        "properties": { "cmd": { "type": "string" }, "exit_code": { "type": "integer" } }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "unevaluatedProperties": false,
        "required": ["id", "tag", "result"],
        "properties": {
          "id": { "type": "string" },
          "tag": { "enum": ["automated", "manual", "policy", "external", "time_observed"] },
          "result": { "enum": ["pass", "fail", "indeterminate", "not_applicable"] },
          "detail": { "type": "string" }
        }
      }
    },
    "verifier_identity": { "type": "string" },
    "session_log_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tokens_cost_note": { "type": "string" },
    "self_asserted": { "type": "boolean", "description": "true = produced by the builder itself without clean-checkout CI under an independent identity. Self-asserted receipts NEVER satisfy a gate; they only track interim progress." },
    "recorded_at": { "type": "string" },
    "notes": { "type": "string" }
  }
}
