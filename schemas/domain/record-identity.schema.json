{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://exposure-atlas.invalid/schemas/domain/record-identity.schema.json",
 "title": "RecordIdentity",
 "type": "object",
 "required": [
  "schema_version",
  "record_id",
  "aliases"
 ],
 "properties": {
  "schema_version": {
   "const": "atlas-record-identity/v1"
  },
  "record_id": {
   "type": "string",
   "pattern": "^rec_[a-z0-9]{8,}$"
  },
  "aliases": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 },
 "unevaluatedProperties": false
}
