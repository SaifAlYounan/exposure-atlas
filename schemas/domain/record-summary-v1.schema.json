{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://exposure-atlas.invalid/schemas/domain/record-summary-v1.schema.json",
 "title": "RecordSummaryV1 (public projection)",
 "type": "object",
 "required": [
  "schema_version",
  "projection_version",
  "release_id",
  "record_id",
  "record_revision_id",
  "boundary_version",
  "facts",
  "notices"
 ],
 "properties": {
  "schema_version": {
   "const": "atlas-record-summary/v1"
  },
  "projection_version": {
   "const": "V1"
  },
  "release_id": {
   "type": "string",
   "pattern": "^rel_[a-z0-9]{8,}$"
  },
  "record_id": {
   "type": "string",
   "pattern": "^rec_[a-z0-9]{8,}$"
  },
  "record_revision_id": {
   "type": "string",
   "pattern": "^rrv_[a-z0-9]{8,}$"
  },
  "boundary_version": {
   "type": "string"
  },
  "facts": {
   "type": "array",
   "items": {
    "type": "object",
    "unevaluatedProperties": false,
    "required": [
     "predicate",
     "raw_value",
     "procedural_modality",
     "semantic_review_state",
     "source_citation"
    ],
    "properties": {
     "predicate": {
      "type": "string"
     },
     "raw_value": {
      "type": "string"
     },
     "normalized_value": {
      "oneOf": [
       {
        "type": "string"
       },
       {
        "type": "boolean"
       },
       {
        "$ref": "https://exposure-atlas.invalid/schemas/domain/common.schema.json#/$defs/money"
       },
       {
        "type": "null"
       }
      ]
     },
     "procedural_modality": {
      "$ref": "https://exposure-atlas.invalid/schemas/domain/common.schema.json#/$defs/procedural_modality"
     },
     "semantic_review_state": {
      "const": "human_approved"
     },
     "source_citation": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
       "issuer",
       "title",
       "content_sha256"
      ],
      "properties": {
       "issuer": {
        "type": "string"
       },
       "title": {
        "type": "string"
       },
       "docket": {
        "type": [
         "string",
         "null"
        ]
       },
       "content_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       }
      }
     }
    }
   }
  },
  "notices": {
   "type": "object",
   "unevaluatedProperties": false,
   "required": [
    "no_match_is_not_absence",
    "not_legal_advice"
   ],
   "properties": {
    "no_match_is_not_absence": {
     "const": true
    },
    "not_legal_advice": {
     "const": true
    }
   }
  }
 },
 "unevaluatedProperties": false
}
