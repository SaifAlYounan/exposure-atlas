{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://exposure-atlas.invalid/schemas/domain/procedural-event.schema.json",
 "title": "ProceduralEvent (append-only; corrections supersede)",
 "type": "object",
 "required": [
  "schema_version",
  "event_id",
  "proceeding_id",
  "kind",
  "legal_time"
 ],
 "properties": {
  "schema_version": {
   "const": "atlas-procedural-event/v1"
  },
  "event_id": {
   "type": "string",
   "pattern": "^evt_[a-z0-9]{8,}$"
  },
  "proceeding_id": {
   "type": "string",
   "pattern": "^prc_[a-z0-9]{8,}$"
  },
  "kind": {
   "enum": [
    "filing",
    "order",
    "judgment",
    "appeal",
    "settlement",
    "remand",
    "withdrawal",
    "consolidation",
    "other"
   ]
  },
  "other_detail": {
   "type": "string"
  },
  "legal_time": {
   "type": "object",
   "unevaluatedProperties": false,
   "required": [
    "effective_date",
    "precision"
   ],
   "properties": {
    "effective_date": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "precision": {
     "enum": [
      "day",
      "month",
      "year"
     ]
    }
   }
  },
  "superseded_by": {
   "type": [
    "string",
    "null"
   ]
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "kind": {
      "const": "other"
     }
    }
   },
   "then": {
    "required": [
     "other_detail"
    ]
   }
  }
 ],
 "unevaluatedProperties": false
}
