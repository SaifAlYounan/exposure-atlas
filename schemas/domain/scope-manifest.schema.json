{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://exposure-atlas.invalid/schemas/domain/scope-manifest.schema.json",
 "title": "ScopeManifest",
 "type": "object",
 "required": [
  "schema_version",
  "boundary_version",
  "jurisdictions",
  "sources",
  "date_window_from",
  "date_window_to",
  "languages"
 ],
 "properties": {
  "schema_version": {
   "const": "atlas-scope-manifest/v1"
  },
  "boundary_version": {
   "type": "string",
   "minLength": 1
  },
  "jurisdictions": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "date_window_from": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "date_window_to": {
   "anyOf": [
    {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    {
     "const": "open"
    }
   ]
  },
  "languages": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "known_gaps": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 },
 "unevaluatedProperties": false
}
